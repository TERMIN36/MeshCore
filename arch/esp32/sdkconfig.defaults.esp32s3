# MeshCore ESP32-S3: Bluetooth modem sleep and automatic light sleep.
# Append to esp32-arduino-lib-builder configs/defconfig.esp32s3
# (branch release/v4.4, Arduino-ESP32 2.0.17, ESP-IDF v4.4.7).
#
# Classic ESP32 calls this ORIG mode. On S3 the only sleep mode is Mode 1.
# The 40 MHz crystal is the low-power clock and stays powered in light sleep
# (Heltec V4 has no 32 kHz crystal). Flash stays powered: V4 PSRAM does not
# survive power-down across light sleep.

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
# CONFIG_ESP_SLEEP_POWER_DOWN_FLASH is not set
