# MeshCore ESP32-C6: BLE modem sleep and automatic light sleep.
# Append to the ESP32-C6 defconfig of esp32-arduino-lib-builder
# (Arduino-ESP32 3.1.3, ESP-IDF v5.3.2).
#
# IDF 5 names the controller sleep BT_LE_SLEEP_ENABLE. The 40 MHz crystal
# is the low-power clock. Flash stays powered.

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
CONFIG_ESP_PHY_MAC_BB_PD=y
# CONFIG_ESP_SLEEP_POWER_DOWN_FLASH is not set
